{
  "name": "koishi-plugin-aka-yib-web-search",
  "version": "0.1.0",
  "description": "YesImBot web search & fetch plugin powered by DeepSeek official Search/Fetch API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BakaAkari/aka-yib-web-search.git"
  },
  "homepage": "https://github.com/BakaAkari/aka-yib-web-search#readme",
  "bugs": {
    "url": "https://github.com/BakaAkari/aka-yib-web-search/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "koishi": "^4.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "koishi": "^4.18.11",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "koishi",
    "koishi-plugin",
    "yesimbot",
    "deepseek",
    "web-search",
    "web-fetch",
    "ai-tools"
  ],
  "koishi": {
    "description": {
      "en": "YesImBot web search & fetch tools powered by DeepSeek official Search/Fetch API.",
      "zh": "基于 DeepSeek 官方 Search / Fetch API 的 YesImBot 联网搜索与网页读取插件。"
    },
    "category": "tool",
    "service": {
      "required": [
        "yesimbot"
      ],
      "implements": [
        "akaYibWebSearch"
      ]
    }
  }
}
